# Copy to backend/.env.local (git-ignored) and fill in. Every setting in stare/config.py can go here with the STARE_ prefix.
STARE_LLM_API_KEY=
STARE_COURTLISTENER_TOKEN=

# LLM mode through OpenRouter (free models end in ":free"):
# STARE_LLM_PROVIDER=openai_compat
# STARE_LLM_BASE_URL=https://openrouter.ai/api/v1
# STARE_LLM_MODEL=<model id>:free
# STARE_LLM_FAST_MODEL=<model id>:free
